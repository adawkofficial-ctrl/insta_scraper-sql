# ==============================================================================
# Instagram Lead Tool - Environment Configuration Template
# Server-side only. Copy to .env and fill in locally.
# Never expose these to the client (no NEXT_PUBLIC_ prefix).
# All values here are placeholders. NEVER commit actual keys or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma ORM
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Node runtime environment ("development", "production", "test")
NODE_ENV="development"

# HTTP server port for local development and production
PORT="3005"

# Set to false only for local plain HTTP (without TLS); in production must be true or unset
COOKIE_SECURE="true"

# Secret key used for signing session JWTs (MUST be at least 32 characters in production)
AUTH_SECRET="change-this-to-a-secure-random-auth-secret-min-32-chars"

# Initial administrator email for the system
ADMIN_EMAIL="admin@example.com"

# Initial administrator password (MUST be changed from default in production)
ADMIN_PASSWORD="ChangeMeInProduction2026!"

# Set to 1 to disable auth rate limiting (testing only, NEVER enable in production)
DISABLE_AUTH_RATE_LIMIT="0"

# ------------------------------------------------------------------------------
# Campaign & Lead Limits
# ------------------------------------------------------------------------------
# Server-side maximum lead limit allowed per campaign and per discovery request (1-100)
MAX_LEAD_LIMIT="100"

# Maximum number of leads allowed in a single profile enrichment batch
MAX_PROFILE_BATCH_SIZE="1000"

# ------------------------------------------------------------------------------
# Scraping Provider Configuration ("apify" or "sparior")
# ------------------------------------------------------------------------------
# Primary scraper provider engine: "apify" or "sparior"
SCRAPER_PROVIDER="apify"

# Primary discovery provider.
# "instagram_all_in_one" (default) uses ONLY apify/instagram-scraper for search + details.
# "google_maps" restores compass/crawler-google-places (Maps phone/rating/reviews).
# Also selectable: "instagram_places", "instagram_search", "hybrid".
DISCOVERY_PROVIDER="instagram_all_in_one"

# Enrichment provider.
# "instagram_scraper" (default) uses apify/instagram-scraper details mode.
# "instagram_profile_scraper" restores apify/instagram-profile-scraper.
ENRICHMENT_PROVIDER="instagram_scraper"

# ------------------------------------------------------------------------------
# Apify Global Cost Guard & Actor Configuration
# ------------------------------------------------------------------------------
# Apify personal API token (server-side only, never leak to client)
APIFY_API_TOKEN="your_apify_token_placeholder_here"

# Master toggle: set to false to block all Apify actor calls instantly
APIFY_ENABLED="true"

# Dry run toggle: true simulates all Apify runs with zero cost and no live network calls
APIFY_DRY_RUN="true"

# Set to true to permit live Apify script executions when --live is also passed
APIFY_ALLOW_LIVE_SCRIPTS="false"

# Comma-separated list of permitted Apify actor IDs (empty allows all configured actors)
APIFY_ALLOWED_ACTORS=""

# Maximum spend permitted for a single Apify actor run in USD
# Set to false to disable monthly/per-run/per-job/pre-run spend ceilings.
# APIFY_ENABLED (kill switch) and APIFY_DRY_RUN still apply.
APIFY_COST_LIMITS_ENABLED="true"
APIFY_MAX_CHARGE_PER_RUN_USD="1.00"

# Maximum budget cap across all rounds/enrichments for a single job in USD
APIFY_MAX_CHARGE_PER_JOB_USD="2.00"

# Monthly spending cap across all Apify runs in USD (leave blank or unset to remove monthly cap)
APIFY_MONTHLY_BUDGET_USD="10.00"

# Optional ISO timestamp (e.g. "2026-11-01T00:00:00Z") to reset historical spend calculation.
# When unset or older than the start of current month, spend calculation begins at the first of the current month.
APIFY_BUDGET_RESET_DATE=""

# Maximum execution timeout in seconds for an Apify actor run
APIFY_RUN_TIMEOUT_SECS="180"

# Memory in MB allocated to Apify actor runs
APIFY_ACTOR_MEMORY_MB="1024"

# Maximum number of Apify actor runs allowed per discovery/enrichment job
APIFY_MAX_RUNS_PER_JOB="4"

# Maximum number of request items allowed per Apify actor run
APIFY_MAX_REQUESTS_PER_RUN="10"

# Apify actor ID used for Instagram profile scraping (LEGACY; only used when
# ENRICHMENT_PROVIDER=instagram_profile_scraper or IG_ENRICHMENT_ACTOR=profile_scraper)
# Pricing: from $2.30 per 1,000 profiles
APIFY_PROFILE_ACTOR_ID="apify/instagram-profile-scraper"

# Apify actor ID used for Instagram keyword and hashtag search discovery
APIFY_DISCOVERY_ACTOR_ID="apify/instagram-search-scraper"

# Apify actor ID used for Google Maps local business crawler
# Pricing: from $3.00 per 1,000 scraped places
APIFY_GMAPS_ACTOR_ID="compass/crawler-google-places"

# Optional actor override. Used by both instagram_all_in_one discovery and
# ENRICHMENT_PROVIDER=instagram_scraper (search + details modes).
APIFY_IG_SCRAPER_ACTOR_ID="apify/instagram-scraper"

# Enables Google Maps crawler's contacts and social scraping add-on (adds $0.002/place).
# When false (default), handle discovery relies on zero-cost website HTML waterfall (homepage, contact pages, linkhubs).
GMAPS_SCRAPE_CONTACTS="false"

# Minimum contactable lead yield threshold (default 0.20 = 20%) before discovery rounds early stop.
# A place counts as contactable if it has ANY channel: Instagram, email, phone, or website.
DISCOVERY_MIN_YIELD_THRESHOLD="0.20"

# Maximum number of discovery results requested from Apify search
APIFY_DISCOVERY_SEARCH_LIMIT="500"

# Enrichment actor mode override: "instagram_scraper_details" (default) or "profile_scraper" (legacy)
# Prefer ENRICHMENT_PROVIDER above; this remains for backward compatibility.
IG_ENRICHMENT_ACTOR="instagram_scraper_details"

# ------------------------------------------------------------------------------
# Sparior Pro (RapidAPI) Configuration (used when SCRAPER_PROVIDER="sparior")
# ------------------------------------------------------------------------------
# RapidAPI Sparior API key
SPARIOR_API_KEY="your_sparior_rapidapi_key_here"

# RapidAPI Sparior API host header
SPARIOR_API_HOST="instagram-social.p.rapidapi.com"

# Sparior API base endpoint URL
SPARIOR_BASE_URL="https://instagram-social.p.rapidapi.com"

# Monthly subscription price in USD for quota tracking
SPARIOR_MONTHLY_PRICE_USD="14.95"

# Monthly request quota allowed by RapidAPI plan
SPARIOR_MONTHLY_REQUEST_LIMIT="10000"

# Maximum RapidAPI requests per single scrape execution
SPARIOR_MAX_REQUESTS_PER_RUN="50"

# Maximum search result pages to fetch per run
SPARIOR_MAX_PAGES_PER_RUN="10"

# Maximum profiles to enrich in a single Sparior run
SPARIOR_MAX_PROFILES_PER_RUN="100"

# Soft budget threshold percentage to trigger warning notifications
SPARIOR_MONTHLY_SOFT_LIMIT_PERCENT="90"

# Delay in milliseconds between consecutive Sparior requests to avoid rate limits
SPARIOR_REQUEST_DELAY_MS="250"

# Minimum RapidAPI quota remaining required before dispatching new discovery runs
SPARIOR_QUOTA_RESERVE="5"

# ------------------------------------------------------------------------------
# Discovery & Enrichment Fine-Tuning
# ------------------------------------------------------------------------------
# Candidate pool size collected before filtering down to target limit
DISCOVERY_MAX_CANDIDATE_POOL="200"

# Maximum iterative search rounds allowed per discovery job
DISCOVERY_MAX_ROUNDS="10"

# Operational stage: "pilot_small" enforces maxLeads=10, GMAPS_MAX_TOTAL_PLACES=15, GMAPS_MAX_CITIES=1
DISCOVERY_STAGE="pilot_small"

# Maximum USD budget allowed for a single discovery execution (hard stop ceiling: $0.60)
DISCOVERY_MAX_JOB_USD="0.60"

# Instagram all-in-one (apify/instagram-scraper) cost & caps
# Conservative price per returned result (search item or details item).
IG_SCRAPER_COST_PER_RESULT_USD="0.0027"
# Results requested per search query (actor searchLimit)
IG_SEARCH_LIMIT="10"
# Hard cap on query variants per job (keyword x city x neighbourhood)
IG_MAX_QUERIES_PER_JOB="6"
# Hard cap on total paid results per job across search + details
IG_MAX_RESULTS_PER_JOB="60"
# Optional comma-separated neighbourhoods used to build extra query variants
IG_NEIGHBOURHOODS=""
# Also run the actor's "place" search as a location signal (costs extra results)
IG_SEARCH_INCLUDE_PLACES="false"
# Local-business criteria defaults for the Instagram-only mode
IG_MIN_FOLLOWERS="300"
IG_MAX_FOLLOWERS="20000"
IG_MIN_POSTS="20"
IG_MAX_DAYS_SINCE_LAST_POST="60"

# Strictness level for lead intent matching ("high", "medium", "low")
DISCOVERY_INTENT_STRICTNESS="medium"

# Whether to run Gemini AI relevance scoring to filter candidate leads
DISCOVERY_USE_AI_RELEVANCE="false"

# Maximum search rounds for Instagram search / hybrid discovery
DISCOVERY_MAX_INSTAGRAM_SEARCH_ROUNDS="1"

# Crawl social media links from Google Maps crawler (false uses free website HTML extractor)
GMAPS_SOCIAL_ENRICHMENT="false"

# Google Maps cost controls
# Max paid search runs (keyword x area) per job
GMAPS_MAX_SEARCHES_PER_JOB="2"
# Skip a (keyword, area) pair for this many days after it was run
DISCOVERY_AREA_COOLDOWN_DAYS="30"
# Reuse accepted/rejected/no_contact place outcomes for this many days
DISCOVERY_CACHE_DAYS="90"
# Auto-stop a batch when IG-ready yield is below this percentage
GMAPS_MIN_IG_YIELD_PERCENT="10"
# Default is one keyword per area; opt in to merge up to 2 keywords per run
GMAPS_MERGE_KEYWORDS="false"
# Optional category filter. The actor bills per returned place, so this stays off by default.
GMAPS_CATEGORY_FILTER=""
# Optional JSON overrides for city sub-areas, e.g. {"toronto":["Leslieville","Yorkville"]}
GMAPS_AREA_OVERRIDES=""

# Maximum places crawled per search keyword in Google Maps discovery
GMAPS_MAX_PLACES_PER_SEARCH="15"

# Maximum total places crawled across all keywords in a Google Maps run (15 in pilot_small)
GMAPS_MAX_TOTAL_PLACES="15"

# Maximum cities queried during multi-city Google Maps discovery (1 in pilot_small)
GMAPS_MAX_CITIES="1"

# Maximum search results returned per Instagram Place query
IG_PLACES_SEARCH_LIMIT="10"

# Geographic search radius in kilometers for Instagram Place search
IG_PLACES_RADIUS_KM="40"

# Maximum USD budget cap for Instagram Place discovery jobs
IG_PLACES_MAX_JOB_USD="0.15"

# Maximum external websites scraped for contact information fallback per run
WEBSITE_FALLBACK_MAX_PER_RUN="20"

# Comma-separated category names treated as national-scale accounts
NATIONAL_SCALE_CATEGORIES="e-commerce,retail,franchise"

# Follower count threshold above which accounts are tagged as national-scale
NATIONAL_SCALE_FOLLOWER_THRESHOLD="100000"

# ------------------------------------------------------------------------------
# AI Provider Configuration ("local", "gemini", or "openai")
# ------------------------------------------------------------------------------
# AI provider used for message drafting and lead scoring: "local", "gemini", or "openai"
AI_PROVIDER="local"

# Google Gemini API key (required if AI_PROVIDER="gemini" or AI relevance filtering is on)
GEMINI_API_KEY=""

# Google Gemini model ID
GEMINI_MODEL="gemini-1.5-flash"

# Maximum concurrency for simultaneous Gemini API requests
AI_MAX_CONCURRENCY="3"

# Request timeout in milliseconds for Gemini API calls
AI_GEMINI_TIMEOUT_MS="30000"

# Rate limit cap: maximum requests per minute for Gemini API
GEMINI_MAX_REQUESTS_PER_MINUTE="30"

# Maximum leads analyzed in a single AI scoring batch
AI_ANALYSIS_MAX_LEADS_PER_JOB="500"

# Minimum AI relevance score (0-100) required to accept a lead
AI_RELEVANCE_MIN_SCORE="70"

# Borderline score band for Gemini gating (clear pass >= 80, clear fail < 30 skip AI call)
GEMINI_BORDERLINE_MIN_SCORE="30"
GEMINI_BORDERLINE_MAX_SCORE="79"

# OpenAI API key (required if AI_PROVIDER="openai")
OPENAI_API_KEY=""

# OpenAI model ID
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# Lead Approval & Auto-Promotion
# ------------------------------------------------------------------------------
# Automatically approve leads meeting quality criteria without manual user review
AUTO_APPROVAL_ENABLED="false"

# Minimum number of leads manually reviewed in a campaign before auto-approval can engage
AUTO_APPROVE_MIN_REVIEWED="50"

# ------------------------------------------------------------------------------
# Messaging Provider & Safety Controls
# ------------------------------------------------------------------------------
# Global kill switch: when false, ALL outbound message dispatching is blocked (SENDING_DISABLED)
# Set to false during discovery-only stages. Default: false.
OUTBOUND_SENDING_ENABLED="false"

# Outbound messaging provider: "playwright" (local browser) or "unipile" (cloud API)
MESSAGING_PROVIDER="playwright"

# Master switch: immediately halts all outbound messaging across all campaigns
PAUSE_ALL_MESSAGING="false"

# Emergency stop switch: instantly aborts all running campaigns and messaging
EMERGENCY_STOP="false"

# Hard maximum ceiling for daily sends across any sender account (cannot be exceeded)
SENDER_DAILY_HARD_MAX="40"

# Default daily send cap for fully warmed sender accounts (new accounts ramp up via warm-up)
SENDER_DAILY_DEFAULT="25"

# Default maximum sends permitted within any rolling 60-minute window per sender account
SENDER_HOURLY_CAP="6"

# Hard maximum ceiling for hourly sends across any sender account
SENDER_HOURLY_HARD_MAX="10"

# Minimum delay between sends in seconds (default 360 = 6 minutes)
SENDER_MIN_GAP_SECONDS="360"

# Maximum delay between sends in seconds (default 900 = 15 minutes, jitter is re-rolled per send)
SENDER_MAX_GAP_SECONDS="900"

# Working hours window start hour in lead's local timezone (0-23, default 9 = 09:00)
WORKING_HOURS_START="9"

# Working hours window end hour in lead's local timezone (0-23, default 18 = 18:00)
WORKING_HOURS_END="18"

# Whether to defer outbound messages on weekends (Saturday/Sunday) in lead's local timezone
SKIP_WEEKENDS="true"

# Lookback window in minutes to reject duplicate identical message text from same sender
MESSAGE_VARIATION_WINDOW_MINUTES="60"

# Maximum link URLs allowed in the first message of an outbound campaign sequence (0 or 1)
FIRST_MESSAGE_MAX_LINKS="1"

# Legacy fallback cooldown interval between consecutive messages sent by the same account
SENDER_COOLDOWN_MINUTES="10"
SENDER_COOLDOWN_SECONDS="600"

# Local browser profile directory for headed manual Instagram login
INSTAGRAM_BROWSER_PROFILE_DIR=".browser_profile"

# Directory where per-sender browser session cookies and state are stored (never commit)
INSTAGRAM_SESSION_DIR="./data/instagram-sessions"

# Timeout in milliseconds for manual browser login before closing window
INSTAGRAM_MANUAL_LOGIN_TIMEOUT_MS="900000"

# ------------------------------------------------------------------------------
# Unipile API Configuration (used when # ------------------------------------------------------------------------------
# EMAIL CHANNEL (SMTP, plain text, one email per lead)
# ------------------------------------------------------------------------------
# Master outbound switch (shared with Instagram/Unipile) also blocks email sends.
# Public base URL used for tokenized unsubscribe links. Email sending is refused without it.
APP_PUBLIC_URL=""
# 32-byte key (64 hex chars or base64) used to encrypt SMTP passwords at rest.
EMAIL_CREDENTIALS_KEY=""
EMAIL_COMPANY_NAME="Your Company"
EMAIL_DAILY_CAP="15"
EMAIL_HOURLY_CAP="4"
EMAIL_DAILY_HARD_MAX="30"
EMAIL_JITTER_MIN_SECONDS="240"
EMAIL_JITTER_MAX_SECONDS="720"
EMAIL_WORKING_HOURS_START="9"
EMAIL_WORKING_HOURS_END="17"

# Existing outbound switch (shared with Instagram/Unipile)
MESSAGING_PROVIDER="unipile")
# ------------------------------------------------------------------------------
# Unipile server DSN host
UNIPILE_DSN="https://api.unipile.com:19650"

# Unipile secret API key
UNIPILE_API_KEY="your_unipile_api_key_here"

# Unipile API v1 base URL
UNIPILE_BASE_URL="https://api.unipile.com:19650/api/v1"

# Webhook path secret for incoming message and account status callbacks
UNIPILE_WEBHOOK_PATH_SECRET="your_secure_random_unipile_webhook_secret"

# ------------------------------------------------------------------------------
# Notifications (ntfy.sh)
# ------------------------------------------------------------------------------
# Maximum push notifications dispatched per minute
NOTIFICATION_MAX_PER_MINUTE="20"

# Minimum lead score (0-100) required to trigger a high-priority push notification
NOTIFICATION_HIGH_SCORE_THRESHOLD="85"

# ------------------------------------------------------------------------------
# Outcome Tracking, Economics & Cost per Reply Allocation
# ------------------------------------------------------------------------------
# Optional monthly sender account / Unipile subscription cost in USD allocated across outbound messages (default: 0.00)
SENDER_ACCOUNT_MONTHLY_COST_USD="0.00"

# Default exploration share (0.0 to 1.0, default: 0.15 = 15%) reserved for testing new keywords/cities in auto-optimized discovery
DISCOVERY_EXPLORATION_SHARE="0.15"

# Sample size threshold (n) required before a segment or message variant is considered statistically confident (default: 30)
ANALYTICS_CONFIDENCE_SAMPLE_SIZE="30"

