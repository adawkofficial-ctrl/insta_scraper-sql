# Server-side only. Copy to .env and fill in locally.
# Next.js loads .env automatically; the Prisma CLI loads it via prisma7.config.ts (dotenv).
# Never expose these to the client (no NEXT_PUBLIC_ prefix).

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Port configuration (optional, defaults to 3001 via package.json scripts)
PORT=3001

# Set to false when serving over plain HTTP (without TLS/HTTPS).
# When omitted, defaults to true in production (Secure cookie flag on).
# Browsers silently drop Secure cookies on non-HTTPS connections, which
# breaks login. Set to false for HTTP-only deployments or HTTP proxies.
# COOKIE_SECURE=false

# Apify API token used by the server-side scraper provider. REQUIRED for
# discovery/enrichment. Server-side only (never NEXT_PUBLIC_*).
APIFY_API_TOKEN=

# OPTIONAL actor overrides (built-in defaults shown). Only change if you need a
# different actor.
APIFY_PROFILE_ACTOR_ID="apify/instagram-profile-scraper"
APIFY_DISCOVERY_ACTOR_ID="apify/instagram-search-scraper"

# Persistent local browser profile directory for manual Instagram session authentication.
# Never commit this directory (already in .gitignore).
INSTAGRAM_BROWSER_PROFILE_DIR=".browser_profile"

# Root directory for per-sender-account Instagram browser sessions. Each sender
# account gets its own profile subdirectory. Never commit this directory.
# This app never stores Instagram passwords or raw cookies in .env or the database.
INSTAGRAM_SESSION_DIR="./data/instagram-sessions"

# Safety limit for a headed manual-login browser window (milliseconds). The
# browser stays open until the user verifies/disconnects, so this is only a
# fallback for abandoned sessions. Default: 900000 (15 minutes).
INSTAGRAM_MANUAL_LOGIN_TIMEOUT_MS="900000"

# Secret key used for signing session tokens (JWT)
AUTH_SECRET="your-secure-random-auth-secret-min-32-chars"

# Optional AI Personalization Provider: "local" (default), "openai", or "gemini"
AI_PROVIDER="local"

# OpenAI Configuration (required if AI_PROVIDER="openai")
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration (required if AI_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Gemini client tuning (Step 5). Safe defaults; no credentials here.
AI_MAX_CONCURRENCY="3"
GEMINI_MAX_REQUESTS_PER_MINUTE="30"
GEMINI_PRICE_INPUT_PER_1M_USD="0"
GEMINI_PRICE_OUTPUT_PER_1M_USD="0"
AI_ANALYSIS_MAX_LEADS_PER_JOB="500"
# Scraper Provider selection: "apify" (default) or "sparior"
SCRAPER_PROVIDER="sparior"

# Sparior Pro (RapidAPI) Configuration (required when SCRAPER_PROVIDER="sparior")
SPARIOR_API_KEY=""
SPARIOR_API_HOST="instagram-social.p.rapidapi.com"
SPARIOR_BASE_URL="https://instagram-social.p.rapidapi.com"
SPARIOR_MONTHLY_PRICE_USD="14.95"
SPARIOR_MONTHLY_REQUEST_LIMIT="10000"
SPARIOR_MAX_REQUESTS_PER_RUN="50"
SPARIOR_MAX_PAGES_PER_RUN="10"
SPARIOR_MAX_PROFILES_PER_RUN="100"
SPARIOR_MONTHLY_SOFT_LIMIT_PERCENT="90"
SPARIOR_REQUEST_DELAY_MS="250"
# Minimum RapidAPI quota remaining (from response headers) to reserve before blocking
# new discovery/scraping requests. Default: 5. Keep this lower (e.g. 3-5) on small/Basic
# plans (100 requests/mo) so discovery isn't blocked prematurely.
SPARIOR_QUOTA_RESERVE="5"

# Messaging Provider selection: "playwright" (local browser) or "unipile" (cloud API)
# Controls fallback provider when an individual sender account does not specify connectionMethod.
MESSAGING_PROVIDER="playwright"

# Unipile API credentials for Instagram messaging and hosted authentication (Step 8)
UNIPILE_DSN="https://api66.unipile.com:19650"
UNIPILE_API_KEY="your_unipile_api_key_here"
UNIPILE_BASE_URL="https://api66.unipile.com:19650/api/v1"

# Webhook path secret for Unipile inbound message and account-status webhooks.
# Webhook routes: /api/webhooks/unipile/account-status/{secret} and /api/webhooks/unipile/new-message/{secret}
UNIPILE_WEBHOOK_PATH_SECRET="your_secure_random_unipile_webhook_secret"

# Push Notifications (ntfy.sh) configuration
NOTIFICATION_MAX_PER_MINUTE="20"
NOTIFICATION_HIGH_SCORE_THRESHOLD="85"

