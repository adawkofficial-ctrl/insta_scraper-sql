/// Single source of truth for first contact across ALL campaigns of a user.
/// The unique key makes exactly one first-message reservation possible.
model LeadContactLedger {
  id                     String         @id @default(cuid())
  userId                 String
  leadId                 String
  campaignId             String
  senderAccountId        String?
  handle                 String         @db.VarChar(191)
  handleNormalized       String         @db.VarChar(191)
  instagramUserId        String?        @db.VarChar(191)
  step                   String         @default("1") @db.VarChar(32)
  channel                MessageChannel @default(INSTAGRAM)
  status                 String         @default("RESERVED") @db.VarChar(32)
  reason                 String?        @db.VarChar(64)
  templateId             String?        @db.VarChar(191)
  variant                String?        @db.VarChar(64)
  renderedTextHash       String?        @db.VarChar(64)
  providerMessageId      String?        @db.VarChar(191)
  threadId               String?        @db.VarChar(191)
  senderUsernameSnapshot String?        @db.VarChar(191)
  reservedAt             DateTime       @default(now())
  sentAt                 DateTime?
  completedAt            DateTime?
  errorCode              String?        @db.VarChar(64)
  metadata               Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign      Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  events        LeadContactEvent[]

  @@unique([userId, handleNormalized, step, channel])
  @@unique([userId, instagramUserId, step, channel])
  @@index([leadId])
  @@index([campaignId])
  @@index([senderAccountId])
  @@index([status])
  @@index([reservedAt])
}

/// Append-only record of every contact attempt, including blocked attempts.
model LeadContactEvent {
  id                     String         @id @default(cuid())
  ledgerId               String?
  userId                 String
  leadId                 String
  campaignId             String
  senderAccountId        String?
  senderUsernameSnapshot String?        @db.VarChar(191)
  step                   String         @db.VarChar(32)
  channel                MessageChannel @default(INSTAGRAM)
  status                 String         @db.VarChar(32)
  reason                 String?        @db.VarChar(64)
  templateId             String?        @db.VarChar(191)
  variant                String?        @db.VarChar(64)
  renderedTextHash       String?        @db.VarChar(64)
  providerMessageId      String?        @db.VarChar(191)
  threadId               String?        @db.VarChar(191)
  scheduledAt            DateTime?
  sentAt                 DateTime?
  errorCode              String?        @db.VarChar(64)
  createdAt              DateTime       @default(now())

  ledger        LeadContactLedger?      @relation(fields: [ledgerId], references: [id], onDelete: SetNull)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign      Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([campaignId, createdAt])
  @@index([senderAccountId, createdAt])
  @@index([status])
}

/// Immutable audit for per-account sending setting changes.
model SenderSettingsAudit {
  id              String   @id @default(cuid())
  userId          String
  senderAccountId String?
  actorUserId     String
  action          String   @db.VarChar(32)
  oldValues       Json?
  newValues       Json?
  createdAt       DateTime @default(now())

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  @@index([senderAccountId, createdAt])
  @@index([userId, createdAt])
}
