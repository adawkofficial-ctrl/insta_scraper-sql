  campaignId             String
  leadId                 String
  step                   Int
  status                 FollowUpStatus @default(SCHEDULED)
  templateText           String         @db.Text
  renderedBody           String?        @db.LongText
  dueAt                  DateTime
  sentAt                 DateTime?
  retryAt                DateTime?
  cancelReason           String?
  errorCode              String?
  errorMessage           String?        @db.Text
  idempotencyKey         String         @unique @db.VarChar(191)
  threadId               String?
  messageId              String?
  senderAccountId        String?
  senderUsernameSnapshot String?        @db.VarChar(191)
  templateId             String?        @db.VarChar(191)
