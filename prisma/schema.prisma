enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED_REPLIED
  CANCELLED_DNC
  CANCELLED_MANUAL
  NEEDS_EDIT
  FAILED
  SKIPPED
}

model FollowUpMessage {
