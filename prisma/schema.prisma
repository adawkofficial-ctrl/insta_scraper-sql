  unipileAccountId String
  unipileMessageId String?  @unique @db.VarChar(191)
  unipileChatId    String?
  providerSenderId String
  username         String?
  text             String   @db.LongText
  receivedAt       DateTime @default(now())
  linkedLeadId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([unipileAccountId])
  @@index([providerSenderId])
  @@index([username])
  @@index([linkedLeadId])
}

enum NotificationEventType {
  LEAD_REPLIED
  HIGH_VALUE_LEAD
  SENDER_ERROR
  SESSION_EXPIRED
  SYSTEM_ERROR
  DAILY_SUMMARY
}

enum NotificationLogStatus {
  SENT
  FAILED
  SKIPPED_DISABLED
}

model NotificationConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  ntfyTopic       String   @db.Text
  ntfyServerUrl   String   @db.Text
  ntfyAccessToken String?  @db.LongText
  enabled         Boolean  @default(true)
  eventTypes      Json? // JSON NotificationEventType[]; app-side filtering
  createdAt       DateTime @default(now())
