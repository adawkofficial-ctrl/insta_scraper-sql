// Prisma schema for the Instagram campaign/lead-generation app.
// Prisma 7: the datasource URL lives in prisma7.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ExecutionMode {
  MANUAL
  REVIEW_REQUIRED
}

enum CampaignExecutionStatus {
  PREVIEW
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum CampaignExecutionPhase {
  DISCOVERY
  ENRICHMENT
  READY
  MESSAGING
  FINALIZING
}

enum ExecutionItemStatus {
  PENDING
  APPROVED
  SENDING
  SKIPPED
  SENT
  FAILED
  SUPPRESSED_DNC
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
}

enum InstagramSenderSessionType {
  PERSISTENT_PROFILE
  STORAGE_STATE
}

enum InstagramSenderStatus {
  CONNECTING
  CONNECTED
  AUTH_REQUIRED
  EXPIRED
  ERROR
  DISCONNECTED
  ACTIVE
  WARMING
  PAUSED
  NEEDS_ATTENTION
}

enum ConnectionMethod {
  PLAYWRIGHT
  UNIPILE
}

enum MessageStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  UNKNOWN
}

enum LeadStatus {
  NEW
  ENRICH_PENDING
  QUALIFYING
  QUALIFIED
  READY_FOR_OUTREACH
  QUEUED
  CONTACTED
  REPLIED
  INTERESTED
  FOLLOW_UP
  MEETING
  CONVERTED
  NOT_INTERESTED
  DO_NOT_CONTACT
}

enum AiStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

enum DncChannel {
  INSTAGRAM
  EMAIL
  PHONE
  ALL
}

enum DncIdentifierType {
  USERNAME
  INSTAGRAM_ID
  EMAIL
  DOMAIN
  PHONE
}

enum DncSource {
  MANUAL
  REPLY_OPT_OUT
  UNSUBSCRIBE
  IMPORT
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageChannel {
  INSTAGRAM
  EMAIL
}

enum UsageProvider {
  SPARIOR
  APIFY
  GEMINI
  ZAPIER
  OTHER
}

enum DraftStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED
  SENT
  // Step 6 additions (appended to avoid enum reordering drift)
  PENDING_REVIEW
  BLOCKED
}

enum DraftReviewAction {
  APPROVE
  REJECT
  EDIT
  REGENERATE
  RECHECK
  OVERRIDE_WARNING
  AUTO_APPROVE
  REVOKE_APPROVAL
}

enum RejectReason {
  TOO_GENERIC
  WRONG_FACT
  TOO_SALESY
  BAD_TONE
  NOT_TARGET
  TOO_LONG
  OTHER
}

enum LeadEventType {
  SENT
  DELIVERED
  REPLIED
  POSITIVE_REPLY
  NEGATIVE_REPLY
  UNSUBSCRIBE_OR_DNC
  MEETING_BOOKED
  WON
}

enum ReplyIntent {
  INTERESTED
  PRICE_REQUEST
  MEETING_REQUEST
  QUESTION
  NOT_INTERESTED
  OUT_OF_OFFICE
  FOLLOW_UP_LATER
  UNCLEAR
}

enum DraftKind {
  OUTREACH
  REPLY
}

enum ApprovalMode {
  MANUAL
  AUTO_ELIGIBLE
}

enum AiAnalysisJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(191)
  name         String?  @db.Text
  image        String?  @db.Text
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns               Campaign[]
  bulkMessageJobs         BulkMessageJob[]
  messageAttempts         MessageAttempt[]
  executions              CampaignExecution[]
  instagramSenderAccounts InstagramSenderAccount[]
  doNotContacts           DoNotContact[]
  conversations           Conversation[]
  usageLogs               UsageLog[]
  leads                   Lead[]
  companyProfiles         CompanyProfile[]
  messageDrafts           MessageDraft[]
  aiAnalysisJobs          AiAnalysisJob[]
  draftReviews            DraftReview[]
  notificationConfig      NotificationConfig?
  notificationLogs        NotificationLog[]
  emailSenderAccounts     EmailSenderAccount[]
  contactLedgerEntries    LeadContactLedger[]
  contactEvents           LeadContactEvent[]
  senderSettingsAudits    SenderSettingsAudit[]

  @@index([email])
  @@index([createdAt])
}

model Campaign {
  id                      String         @id @default(cuid())
  userId                  String
  name                    String         @db.VarChar(200)
  description             String?        @db.Text
  status                  CampaignStatus @default(DRAFT)
  executionMode           ExecutionMode  @default(MANUAL)
  messageApprovalRequired Boolean        @default(true)
  scheduledAt             DateTime?
  // Discovery intent (remember what the user searched for)
  intent                  String?        @db.Text
  location                String?        @db.VarChar(1000)
  category                String?        @db.Text
  leadLimit               Int?
  // Follow-up Configuration
  followUpEnabled         Boolean        @default(false)
  followUpCount           Int            @default(1)
  followUpDelayDays       Json? // JSON number[]; use parseFollowUpDelayDays()
  followUpTemplates       Json? // JSON string[]; use parseStringArray()
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads            Lead[]
  scrapeJobs       ScrapeJob[]
  messages         Message[]
  templates        MessageTemplate[]
  emailSettings    EmailCampaignSettings?
  emailSends       EmailSend[]
  executions       CampaignExecution[]
  bulkMessageJobs  BulkMessageJob[]
  messageAttempts  MessageAttempt[]
  conversations    Conversation[]
  usageLogs        UsageLog[]
  leadSightings    LeadSighting[]
  companyProfileId String
  companyProfile   CompanyProfile         @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  messageDrafts    MessageDraft[]
  aiAnalysisJobs   AiAnalysisJob[]
  followUpMessages FollowUpMessage[]

  // AI qualification settings (Step 5). Defaults keep legacy behavior unchanged.
  aiQualificationEnabled Boolean @default(false)
  minLeadScore           Int     @default(60)
  aiInstructions         String? @db.Text
  targetNiche            String? @db.VarChar(191)
  messageLanguage        String?

  // Step 6: quality gate + approval workflow. Defaults keep legacy behavior.
  requireApproval         Boolean      @default(true)
  approvalMode            ApprovalMode @default(MANUAL)
  autoApproveMinScore     Int          @default(80)
  qualityMaxRegenerations Int          @default(2)

  // Quality score & chain filtering settings
  customNegativeKeywords Json? // JSON string[]; use parseStringArray()
  customPositiveKeywords Json? // JSON string[]; use parseStringArray()
  minRating              Float?
  minReviews             Int?
  excludeChains          Boolean @default(true)

  // First-message personalization / re-contact policy (multi-account task)
  requireNameInFirstMessage Boolean @default(true)
  allowNeutralGreeting      Boolean @default(false)
  followUpAllowSenderSwitch Boolean @default(false)
  reContactCooldownDays     Int?

  // Outcome optimization & feedback loop (Step 4)
  autoOptimize           Boolean             @default(false)
  explorationBudgetShare Float               @default(0.15)
  leadEvents             LeadEvent[]
  candidates             Candidate[]
  contactLedger          LeadContactLedger[]
  contactEvents          LeadContactEvent[]

  @@index([userId])
  @@index([status])
  @@index([executionMode])
  @@index([createdAt])
}

model Lead {
  id                   String    @id @default(cuid())
  campaignId           String
  username             String?   @db.VarChar(191)
  instagramUsername    String?   @db.VarChar(191)
  profileUrl           String?   @db.VarChar(512)
  fullName             String?   @db.VarChar(255)
  biography            String?   @db.LongText
  followers            Int? // DEPRECATED: use followersCount
  following            Int?
  postsCount           Int?
  profilePictureUrl    String?   @db.Text
  profilePicUrl        String?   @db.Text
  profilePicUrlHD      String?   @db.Text
  isVerified           Boolean? // DEPRECATED: use verified
  verified             Boolean?
  isBusiness           Boolean? // DEPRECATED: use isBusinessAccount
  isBusinessAccount    Boolean?
  category             String?   @db.VarChar(191)
  businessCategoryName String?   @db.VarChar(191)
  externalUrl          String?   @db.Text
  instagramId          String?
  location             String?   @db.Text
  followersCount       Int?
  followsCount         Int?
  relatedProfiles      Json?
  latestPosts          Json?
  rawProfileData       Json?
  source               String    @default("apify")
  scrapedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foundation fields for Lead-Gen Platform
  status                      LeadStatus @default(NEW)
  statusUpdatedAt             DateTime   @default(now())
  instagramUserId             String?
  email                       String?    @db.VarChar(254)
  emailNormalized             String?    @db.VarChar(191)
  phone                       String?
  phoneNormalized             String?    @db.VarChar(191)
  website                     String?    @db.Text
  websiteDomain               String?    @db.VarChar(191)
  socialLink                  String?    @db.VarChar(512)
  socialPlatform              String?
  contactSource               String?
  emailSourceUrl              String?    @db.Text
  emailFoundAt                DateTime?
  emailConfidence             Float?
  emailRole                   String? // "generic" | "named" | null
  emailInvalid                Boolean    @default(false)
  emailOptOutAt               DateTime?
  // Canonical channel flags. Keep in sync via syncLeadChannelFlags().
  hasInstagram                Boolean    @default(false)
  hasEmail                    Boolean    @default(false)
  hasPhone                    Boolean    @default(false)
  hasWebsite                  Boolean    @default(false)
  hasOtherSocial              Boolean    @default(false)
  leadScore                   Int?
  leadQuality                 String? // "high" | "medium" | "low"
  aiStatus                    AiStatus   @default(PENDING)
  aiAnalysis                  Json?
  aiAnalyzedAt                DateTime?
  aiFailedReason              String?    @db.Text
  promptVersion               String?
  lastContactedAt             DateTime?
  // Sticky multi-account contact attribution (first reservation wins).
  assignedSenderAccountId     String?
  firstContactedAt            DateTime?
  firstContactedBySenderId    String?
  contactedByUsernameSnapshot String?    @db.VarChar(191)
  outreachCount               Int        @default(0)

  // Multi-attribute deduplication (per-user identity)
  userId                    String?
  usernameNormalized        String?   @db.VarChar(191)
  profileUrlCanonical       String?   @db.Text
  websiteKey                String?   @db.VarChar(191)
  previousUsernames         Json? // JSON string[]; use parsePreviousUsernames()
  duplicateOfLeadId         String?
  dedupMatchedBy            String?
  dedupFlaggedAt            DateTime?
  possibleDuplicateOfLeadId String?
  possibleDuplicateReason   String?   @db.Text
  // App-maintained guard keys for the three former Postgres partial unique
  // indexes. NULL means "not guarded"; Prisma extension keeps them in sync.
  activeInstagramGuard      String?
  activeUsernameGuard       String?
  activeEmailGuard          String?

  // Google Maps / Multi-channel discovery fields
  gmapsPlaceId     String? @db.VarChar(191)
  rating           Float?
  reviewCount      Int?
  city             String? @db.VarChar(191)
  handleSource     String?
  handleConfidence String?

  // Lead Quality Scoring & Chain Detection
  qualityScore   Int?
  qualityTier    String? // "A" | "B" | "C" | "D"
  scoreBreakdown Json?
  scoreFlags     LeadScoreFlag[]
  isChain        Boolean         @default(false)
  isClaimed      Boolean?
  lastPostAt     DateTime?
  scoreVersion   Int             @default(1)

  // Attribution & Cost Tracking (Step 1)
  scrapeJobId              String?
  discoveryKeyword         String?                 @db.VarChar(191)
  discoveryCity            String?                 @db.VarChar(191)
  acquisitionCostUsd       Decimal?                @db.Decimal(10, 4)
  emailSends               EmailSend[]
  emailUnsubscribeTokens   EmailUnsubscribeToken[]
  acquisitionCostBreakdown Json?
  messageVariant           String? // A/B test variant: "A" | "B" | "C" @db.VarChar(64)

  // Pilot and dry-run isolation
  isDryRun Boolean @default(false)

  // Multi-location group detection & deduplication
  isGroup                Boolean   @default(false)
  groupKey               String?   @db.VarChar(191)
  lastHandleEnrichmentAt DateTime?

  campaign            Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scrapeJob           ScrapeJob?              @relation(fields: [scrapeJobId], references: [id], onDelete: SetNull)
  assignedSender      InstagramSenderAccount? @relation("LeadAssignedSender", fields: [assignedSenderAccountId], references: [id], onDelete: SetNull)
  firstContactedBy    InstagramSenderAccount? @relation("LeadFirstContactSender", fields: [firstContactedBySenderId], references: [id], onDelete: SetNull)
  contactLedger       LeadContactLedger[]
  contactEvents       LeadContactEvent[]
  events              LeadEvent[]
  messages            Message[]
  executionItems      CampaignExecutionItem[]
  bulkMessageItems    BulkMessageItem[]
  messageAttempts     MessageAttempt[]
  statusHistory       LeadStatusHistory[]
  conversations       Conversation[]
  followUpMessages    FollowUpMessage[]
  sightings           LeadSighting[]
  duplicateOf         Lead?                   @relation("LeadDuplicates", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  duplicates          Lead[]                  @relation("LeadDuplicates")
  possibleDuplicateOf Lead?                   @relation("LeadPossibleDuplicates", fields: [possibleDuplicateOfLeadId], references: [id], onDelete: SetNull)
  possibleDuplicates  Lead[]                  @relation("LeadPossibleDuplicates")
  messageDrafts       MessageDraft[]
  // NOTE: three partial unique guards exist in the DB but are NOT expressible in
  // Prisma schema (see migration 20260928130500_step4_dedup_unique_guards):
  //   UNIQUE (userId, instagramUserId)    WHERE key NOT NULL AND duplicateOfLeadId IS NULL
  //   UNIQUE (userId, usernameNormalized) WHERE key NOT NULL AND duplicateOfLeadId IS NULL
  //   UNIQUE (userId, emailNormalized)    WHERE key NOT NULL AND duplicateOfLeadId IS NULL
  // `prisma migrate diff --from-config-datasource --to-schema` currently reports
  // NO drift (Prisma ignores unmodelled partial indexes). If a future version
  // reports them as DROP INDEX, do NOT accept it ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â they are the concurrency guard.

  @@unique([campaignId, username])
  @@unique([userId, activeInstagramGuard])
  @@unique([userId, activeUsernameGuard])
  @@unique([userId, activeEmailGuard])
  @@index([hasInstagram])
  @@index([hasEmail])
  @@index([hasPhone])
  @@index([hasWebsite])
  @@index([hasOtherSocial])
  @@index([campaignId])
  @@index([username])
  @@index([profileUrl])
  @@index([fullName])
  @@index([category])
  @@index([createdAt])
  @@index([campaignId, createdAt])
  @@index([campaignId, hasInstagram, createdAt])
  @@index([campaignId, hasEmail, createdAt])
  @@index([campaignId, hasWebsite, createdAt])
  @@index([status])
  @@index([campaignId, status])
  @@index([instagramUserId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([websiteDomain])
  @@index([leadScore])
  @@index([userId])
  @@index([userId, usernameNormalized])
  @@index([userId, instagramUserId])
  @@index([userId, emailNormalized])
  @@index([userId, websiteKey])
  @@index([duplicateOfLeadId])
  @@index([possibleDuplicateOfLeadId])
  @@index([gmapsPlaceId])
  @@index([userId, gmapsPlaceId])
  @@index([qualityScore])
  @@index([qualityTier])
  @@index([scrapeJobId])
  @@index([discoveryKeyword])
  @@index([discoveryCity])
  @@index([isDryRun])
  @@index([campaignId, isDryRun])
  @@index([groupKey])
  @@index([campaignId, groupKey])
  @@index([messageVariant])
  @@index([assignedSenderAccountId])
  @@index([firstContactedBySenderId])
  @@index([firstContactedAt])
  @@index([lastContactedAt])
  @@index([contactedByUsernameSnapshot])
}

model LeadScoreFlag {
  id     String @id @default(cuid())
  leadId String
  flag   String @db.VarChar(191)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, flag])
  @@index([flag])
}

/// Records that a lead was seen in a campaign/run. Never merges or deletes;
/// it is the cross-campaign provenance trail used by the duplicate report.
model LeadSighting {
  id          String   @id @default(cuid())
  leadId      String
  campaignId  String
  scrapeJobId String?
  source      String
  matchedBy   String?
  createdAt   DateTime @default(now())

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([campaignId, createdAt])
  @@index([scrapeJobId])
}

model ScrapeJob {
  id                   String          @id @default(cuid())
  campaignId           String?
  status               ScrapeJobStatus @default(PENDING)
  provider             String
  inputCount           Int             @default(0)
  processedCount       Int             @default(0)
  errorMessage         String?         @db.Text
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime        @default(now())
  // Discovery metadata (nullable for plain profile-scrape jobs)
  query                String?         @db.Text
  location             String?         @db.Text
  category             String?         @db.Text
  discoveryActor       String?
  enrichmentActor      String?
  requestedLimit       Int?
  candidatesDiscovered Int?
  candidatesEnriched   Int?
  candidatesSkipped    Int?
  usage                Json?
  stopReason           String?
  costUsd              Decimal?        @db.Decimal(10, 4)
  costBreakdown        Json?
  isDryRun             Boolean         @default(false)

  campaign   Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  executions CampaignExecution[]
  leads      Lead[]
  candidates Candidate[]

  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@index([isDryRun])
  @@index([campaignId, isDryRun])
}

model DiscoveryCoverage {
  id            String   @id @default(cuid())
  userId        String
  campaignId    String?
  keyword       String
  area          String
  runDate       DateTime @default(now())
  placeIds      Json
  newPlaces     Int      @default(0)
  acceptedLeads Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId, keyword, area, runDate])
  @@index([userId, runDate])
}

model DiscoveryPlaceOutcome {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  outcome   String
  reason    String?
  keyword   String?
  area      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId, updatedAt])
}

model Candidate {
  id               String   @id @default(cuid())
  campaignId       String
  scrapeJobId      String?
  runId            String?
  datasetId        String?
  costUsd          Decimal? @db.Decimal(10, 4)
  placeId          String
  name             String   @db.VarChar(255)
  category         String?  @db.Text
  address          String?  @db.Text
  city             String?
  state            String?
  countryCode      String?
  phone            String?
  website          String?  @db.Text
  rating           Float?
  reviewsCount     Int?
  mapsUrl          String?  @db.Text
  status           String   @default("DISCOVERED")
  rejectionReason  String?  @db.Text
  lastError        String?  @db.Text
  handle           String?
  handleSource     String?
  handleConfidence String?
  socialLinks      Json?
  rawPlaceData     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scrapeJob ScrapeJob? @relation(fields: [scrapeJobId], references: [id], onDelete: SetNull)

  @@unique([campaignId, placeId])
  @@index([campaignId, status])
  @@index([scrapeJobId])
  @@index([placeId])
}

model EmailSenderAccount {
  id                    String    @id @default(cuid())
  userId                String
  fromName              String
  fromAddress           String
  postalAddress         String    @db.Text
  smtpHost              String    @db.VarChar(191)
  smtpPort              Int
  smtpUser              String
  smtpPasswordEncrypted String    @db.LongText
  secure                Boolean   @default(true)
  status                String    @default("PENDING") // PENDING | ACTIVE | PAUSED | DISABLED
  dailyCap              Int       @default(15)
  hourlyCap             Int       @default(4)
  warmupStartedAt       DateTime?
  lastSentAt            DateTime?
  consecutiveErrors     Int       @default(0)
  pausedUntil           DateTime?
  lastError             String?   @db.Text
  verifiedAt            DateTime?
  dnsCheckedAt          DateTime?
  spfStatus             String?
  dkimStatus            String?
  dmarcStatus           String?
  dkimSelector          String?
  allowDnsOverride      Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sends EmailSend[]

  @@index([userId])
  @@index([userId, status])
}

model EmailCampaignSettings {
  id              String   @id @default(cuid())
  campaignId      String   @unique
  subjectTemplate String   @db.VarChar(1000)
  bodyTemplate    String   @db.LongText
  enabled         Boolean  @default(false)
  templateVersion Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model EmailSend {
  id                String    @id @default(cuid())
  campaignId        String?
  leadId            String?
  senderAccountId   String
  recipient         String    @db.VarChar(254)
  recipientDomain   String?   @db.VarChar(191)
  status            String    @default("QUEUED") // QUEUED | SENT | UNKNOWN | FAILED | SUPPRESSED
  subject           String    @db.Text
  body              String    @db.LongText
  messageId         String?
  templateVersion   Int       @default(1)
  senderIdentity    String
  addressSource     String?
  addressFoundAt    DateTime?
  addressConfidence Float?
  errorCode         String?
  errorMessage      String?   @db.Text
  groupKey          String?
  isTest            Boolean   @default(false)
  reservedAt        DateTime  @default(now())
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign      Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderAccount EmailSenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Restrict)

  @@unique([leadId])
  @@index([campaignId, status])
  @@index([senderAccountId, createdAt])
  @@index([recipientDomain])
}

model EmailUnsubscribeToken {
  id              String    @id @default(cuid())
  token           String    @unique @db.VarChar(191)
  leadId          String
  campaignId      String?
  emailNormalized String
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Message {
  id                     String        @id @default(cuid())
  campaignId             String
  leadId                 String
  provider               String        @default("playwright")
  providerMessageId      String?       @db.VarChar(191)
  status                 MessageStatus @default(DRAFT)
  messageText            String        @db.LongText
  errorCode              String?
  errorMessage           String?       @db.Text
  idempotencyKey         String?       @db.VarChar(191)
  contentHash            String?       @db.VarChar(64)
  sentAt                 DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  senderAccountId        String?
  senderUsernameSnapshot String?       @db.VarChar(191)
  step                   String?       @db.VarChar(32)
  templateId             String?       @db.VarChar(191)
  variant                String?       @db.VarChar(64)
  renderedTextHash       String?       @db.VarChar(64)
  threadId               String?       @db.VarChar(191)
  scheduledAt            DateTime?
  // Step 6: every draft-based message links back to its approved draft.
  draftId                String?

  // Step 8: Unipile message & chat correlation
  unipileMessageId String? @unique @db.VarChar(191)
  unipileChatId    String? @db.VarChar(191)

  // Foundation & Inbound fields
  direction                   MessageDirection @default(OUTBOUND)
  channel                     MessageChannel   @default(INSTAGRAM)
  conversationId              String?
  aiGenerated                 Boolean          @default(false)
  promptVersion               String?
  receivedAt                  DateTime?
  intent                      String?
  interestLevel               String?
  requiresHuman               Boolean          @default(false)
  aiAnalysis                  Json?
  classifiedAt                DateTime?
  classificationPromptVersion String?
  replyCategory               String? // "positive" | "question" | "not_now" | "negative" | "unsubscribe" | "spam" | "unknown"

  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead             Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadEvents       LeadEvent[]
  attempts         MessageAttempt[]
  senderAccount    InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  conversation     Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  draft            MessageDraft?           @relation(fields: [draftId], references: [id], onDelete: SetNull)
  replyDrafts      MessageDraft[]          @relation("MessageDraftReplyTo")
  followUpMessages FollowUpMessage[]

  @@index([leadId])
  @@index([campaignId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([contentHash])
  @@index([senderAccountId])
  @@index([conversationId])
  @@index([unipileChatId])
  @@index([draftId])
  @@index([createdAt])
  @@index([intent])
  @@index([classifiedAt])
}

model MessageTemplate {
  id         String   @id @default(cuid())
  campaignId String?
  name       String   @db.Text
  body       String   @db.LongText
  variants   Json? // Optional A/B variants: [{ id: "A", body: "..." }, { id: "B", body: "..." }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bulkMessageJobs BulkMessageJob[]

  @@index([campaignId])
  @@index([createdAt])
}

model InstagramSenderAccount {
  id               String                     @id @default(cuid())
  userId           String
  username         String
  displayName      String?                    @db.Text
  connectionMethod ConnectionMethod           @default(PLAYWRIGHT)
  unipileAccountId String?                    @unique @db.VarChar(191)
  sessionType      InstagramSenderSessionType @default(PERSISTENT_PROFILE)
  sessionPath      String                     @db.Text
  status           InstagramSenderStatus      @default(CONNECTING)
  lastVerifiedAt   DateTime?
  lastError        String?                    @db.Text
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  // Persistent send-gate safety counters & settings (Step 2 & 3)
  lastSentAt            DateTime?
  sentToday             Int       @default(0)
  sentTodayDate         String?
  sentThisHour          Int       @default(0)
  sentThisHourWindow    String?
  totalSent             Int       @default(0)
  warmupStartedAt       DateTime?
  pausedUntil           DateTime?
  lastErrorCode         String?
  consecutiveErrors     Int       @default(0)
  dailyCap              Int?
  hourlyCap             Int?
  customMinGapSeconds   Int?
  customMaxGapSeconds   Int?
  timezone              String    @default("UTC")
  workingHoursStart     Int       @default(9)
  workingHoursEnd       Int       @default(18)
  warmupEnabled         Boolean   @default(true)
  // Stable per-account offset so many accounts do not start the same minute.
  scheduleOffsetSeconds Int       @default(0)
  settingsUpdatedAt     DateTime?

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              Message[]
  messageAttempts       MessageAttempt[]
  bulkMessageJobs       BulkMessageJob[]
  bulkMessageItems      BulkMessageItem[]
  conversations         Conversation[]
  outboundIdempotencies OutboundSendIdempotency[]
  assignedLeads         Lead[]                    @relation("LeadAssignedSender")
  firstContactedLeads   Lead[]                    @relation("LeadFirstContactSender")
  contactLedgerEntries  LeadContactLedger[]
  contactEvents         LeadContactEvent[]
  settingsAudits        SenderSettingsAudit[]

  @@unique([userId, username])
  @@index([userId])
  @@index([status])
  @@index([connectionMethod])
  @@index([unipileAccountId])
  @@index([createdAt])
  @@index([lastSentAt])
  @@index([pausedUntil])
}

model OutboundSendIdempotency {
  id              String    @id @default(cuid())
  campaignId      String
  leadId          String
  step            String    @default("1")
  senderAccountId String?
  status          String    @default("RESERVED") // RESERVED | SENT | FAILED | UNKNOWN
  messageId       String?
  errorCode       String?
  errorMessage    String?   @db.Text
  contentHash     String?
  reservedAt      DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  @@unique([campaignId, leadId, step])
  @@index([campaignId, leadId])
  @@index([senderAccountId])
  @@index([status])
  @@index([reservedAt])
}

model CampaignExecution {
  id               String                  @id @default(cuid())
  campaignId       String
  userId           String?
  status           CampaignExecutionStatus @default(READY)
  phase            CampaignExecutionPhase  @default(READY)
  executionMode    ExecutionMode           @default(MANUAL)
  workerId         String?
  leaseUntil       DateTime?
  heartbeatAt      DateTime?
  totalItems       Int                     @default(0)
  processedItems   Int                     @default(0)
  successfulItems  Int                     @default(0)
  failedItems      Int                     @default(0)
  errorCode        String?
  errorMessage     String?                 @db.Text
  scrapeJobId      String?
  bulkMessageJobId String?
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  campaign       Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  scrapeJob      ScrapeJob?              @relation(fields: [scrapeJobId], references: [id], onDelete: SetNull)
  bulkMessageJob BulkMessageJob?         @relation(fields: [bulkMessageJobId], references: [id], onDelete: SetNull)
  items          CampaignExecutionItem[]

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([phase])
  @@index([workerId])
  @@index([leaseUntil])
  @@index([createdAt])
}

model CampaignExecutionItem {
  id           String              @id @default(cuid())
  executionId  String
  leadId       String
  status       ExecutionItemStatus @default(PENDING)
  messageText  String              @db.Text
  errorMessage String?             @db.Text
  processedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  execution CampaignExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  lead      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([executionId, leadId])
  @@index([executionId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

enum BulkMessageJobStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum BulkMessageItemStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
  CANCELLED
  UNKNOWN
  SUPPRESSED_DNC
}

model BulkMessageJob {
  id              String               @id @default(cuid())
  campaignId      String
  userId          String
  // Null for Step 6 draft-based send jobs (no template).
  templateId      String?
  status          BulkMessageJobStatus @default(DRAFT)
  total           Int                  @default(0)
  queued          Int                  @default(0)
  processing      Int                  @default(0)
  sent            Int                  @default(0)
  failed          Int                  @default(0)
  skipped         Int                  @default(0)
  cancelled       Int                  @default(0)
  unknown         Int                  @default(0)
  errorMessage    String?              @db.Text
  senderAccountId String?
  createdAt       DateTime             @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  updatedAt       DateTime             @updatedAt

  campaign      Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      MessageTemplate?        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items         BulkMessageItem[]
  attempts      MessageAttempt[]
  executions    CampaignExecution[]
  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([senderAccountId])
  @@index([createdAt])
}

model BulkMessageItem {
  id                String                @id @default(cuid())
  jobId             String
  leadId            String
  renderedMessage   String                @db.LongText
  status            BulkMessageItemStatus @default(QUEUED)
  attempts          Int                   @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?               @db.Text
  providerMessageId String?               @db.VarChar(191)
  senderAccountId   String?
  templateId        String?               @db.VarChar(191)
  variant           String?               @db.VarChar(64)
  idempotencyKey    String?               @db.VarChar(191)
  contentHash       String?               @db.VarChar(64)
  // Step 6: draft-based items carry the approved draft and its exact body/hash.
  // Unique: a draft can be attached to at most one item (no double-send).
  draftId           String?               @unique
  renderedBody      String?               @db.LongText
  bodyHash          String?               @db.VarChar(64)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  job             BulkMessageJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead            Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderAccount   InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  messageAttempts MessageAttempt[]

  @@unique([jobId, leadId])
  @@index([jobId])
  @@index([leadId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([contentHash])
  @@index([createdAt])
}

model MessageAttempt {
  id                     String         @id @default(cuid())
  userId                 String
  campaignId             String
  leadId                 String
  jobId                  String?
  itemId                 String?
  messageId              String?
  direction              String         @default("OUTBOUND")
  status                 MessageStatus  @default(SENDING)
  messageText            String         @db.LongText
  provider               String         @default("playwright")
  providerMessageId      String?        @db.VarChar(191)
  attemptNumber          Int            @default(1)
  idempotencyKey         String?        @db.VarChar(191)
  contentHash            String?        @db.VarChar(64)
  errorCode              String?
  errorMessage           String?        @db.Text
  startedAt              DateTime       @default(now())
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  senderAccountId        String?
  senderUsernameSnapshot String?        @db.VarChar(191)
  step                   String?        @db.VarChar(32)
  channel                MessageChannel @default(INSTAGRAM)
  templateId             String?        @db.VarChar(191)
  variant                String?        @db.VarChar(64)
  renderedTextHash       String?        @db.VarChar(64)
  threadId               String?        @db.VarChar(191)
  scheduledAt            DateTime?

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign      Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  job           BulkMessageJob?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item          BulkMessageItem?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  message       Message?                @relation(fields: [messageId], references: [id], onDelete: Cascade)
  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([campaignId])
  @@index([userId])
  @@index([jobId])
  @@index([itemId])
  @@index([messageId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([contentHash])
  @@index([senderAccountId])
  @@index([createdAt])
}

model LeadStatusHistory {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  reason     String?
  actor      String
  createdAt  DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model DoNotContact {
  id                   String            @id @default(cuid())
  userId               String
  channel              DncChannel
  identifierType       DncIdentifierType
  identifierNormalized String            @db.VarChar(320)
  reason               String?
  source               DncSource
  createdAt            DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, identifierType, identifierNormalized])
  @@index([identifierNormalized])
  @@index([userId])
}

model Conversation {
  id               String         @id @default(cuid())
  userId           String
  leadId           String
  campaignId       String?
  senderAccountId  String?
  channel          MessageChannel
  externalThreadId String?
  unipileChatId    String?        @unique
  status           String         @default("OPEN")
  requiresHuman    Boolean        @default(false)
  unreadCount      Int            @default(0)
  lastMessageAt    DateTime?
  lastInboundAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead          Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign      Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  senderAccount InstagramSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([leadId, channel])
  @@index([userId, requiresHuman])
  @@index([lastInboundAt])
  @@index([userId])
  @@index([campaignId])
  @@index([unipileChatId])
}

model UsageLog {
  id               String        @id @default(cuid())
  userId           String?
  campaignId       String?
  provider         UsageProvider
  operation        String
  requestCount     Int           @default(1)
  itemsReturned    Int?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal?      @db.Decimal(12, 6)
  quotaRemaining   Int?
  metadata         Json?
  scrapeJobId      String?
  createdAt        DateTime      @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
  @@index([scrapeJobId])
}

/// Company knowledge base (source of truth for what the company sells).
/// Fields are entered by the user via Settings; never seed or invent values.
model CompanyProfile {
  id                   String   @id @default(cuid())
  userId               String
  name                 String   @db.Text
  isDefault            Boolean  @default(false)
  description          String?  @db.Text
  services             Json? // JSON string[]; default [] applied in code
  targetIndustries     Json? // JSON string[]; use parseStringArray()
  targetCountries      Json? // JSON string[]; use parseStringArray()
  idealCustomerProfile String?  @db.Text
  brandTone            String?
  messageLanguage      String   @default("en")
  preferredLength      Json?
  ctaStyle             String?
  forbiddenClaims      Json? // JSON string[]; use parseStringArray()
  pricingPolicy        String?  @db.Text
  exampleMessages      Json?
  objectionNotes       String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([userId])
}

/// AI-generated message draft. Stored only; never sent in Step 5.
model MessageDraft {
  id                        String         @id @default(cuid())
  userId                    String
  leadId                    String
  campaignId                String
  body                      String         @db.LongText
  subject                   String?        @db.Text
  channel                   MessageChannel @default(INSTAGRAM)
  kind                      DraftKind      @default(OUTREACH)
  replyToMessageId          String?
  status                    DraftStatus    @default(DRAFT)
  promptVersion             String
  model                     String
  personalizationPointsUsed Json?
  generationMeta            Json?
  wordCount                 Int
  // Step 6: quality gate + approval fields.
  qualityVersion            String?
  qualityScore              Int?
  qualityPassed             Boolean?
  qualityResult             Json?
  qualityCheckedAt          DateTime?
  regenerationCount         Int            @default(0)
  editedBody                String?        @db.LongText
  bodyHash                  String?        @db.VarChar(64)
  approvedBodyHash          String?        @db.VarChar(64)
  approvedAt                DateTime?
  approvedByType            String?
  approvedById              String?
  rejectedAt                DateTime?
  rejectReasonCode          String?
  rejectNotes               String?        @db.Text
  editDistance              Int?
  warningOverrides          Json?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  replyToMessage Message?      @relation("MessageDraftReplyTo", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  reviews        DraftReview[]
  messages       Message[]

  @@index([leadId, createdAt])
  @@index([campaignId, status])
  @@index([userId, createdAt])
  @@index([qualityPassed])
  @@index([kind])
  @@index([replyToMessageId])
}

/// Step 6: append-only audit trail for every draft review action.
model DraftReview {
  id             String            @id @default(cuid())
  draftId        String
  userId         String?
  actorType      String // "user" | "system"
  action         DraftReviewAction
  reasonCode     String?
  notes          String?           @db.Text
  meta           Json?
  bodyHashBefore String?
  bodyHashAfter  String?
  createdAt      DateTime          @default(now())

  draft MessageDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([draftId, createdAt])
  @@index([userId])
}

/// In-process AI analysis job (Step 7 will wrap this in a BullMQ worker).
model AiAnalysisJob {
  id              String              @id @default(cuid())
  userId          String
  campaignId      String
  status          AiAnalysisJobStatus @default(PENDING)
  total           Int                 @default(0)
  processed       Int                 @default(0)
  succeeded       Int                 @default(0)
  failed          Int                 @default(0)
  skipped         Int                 @default(0)
  cancelRequested Boolean             @default(false)
  options         Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastError       String?             @db.Text
  createdAt       DateTime            @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
}

enum UnipileWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model UnipileWebhookEvent {
  id             String               @id @default(cuid())
  eventType      String
  unipileEventId String?              @unique
  rawPayloadHash String               @db.VarChar(64)
