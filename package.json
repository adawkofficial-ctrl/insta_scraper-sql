{
  "name": "insta_scraper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3005",
    "build": "next build --webpack",
    "start": "next start -p 3005",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-all-tests.ts",
    "resume:job": "tsx -r ./scripts/preload_server_only.cjs scripts/resume_job.ts",
    "import:apify-dataset": "tsx -r ./scripts/preload_server_only.cjs scripts/import_apify_dataset.ts",
    "preflight": "tsx scripts/preflight.ts",
    "cleanup:dryrun": "tsx scripts/cleanup-dry-run-data.ts",
    "replay:gmaps": "tsx -r ./scripts/preload_server_only.cjs scripts/replay_gmaps.ts",
    "rehandle": "tsx -r ./scripts/preload_server_only.cjs scripts/rehandle_leads.ts",
    "test:db:setup": "node scripts/setup-test-db.cjs",
    "etl:mysql": "tsx scripts/etl/run.ts",
    "etl:verify": "tsx scripts/etl/verify.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:admin": "tsx scripts/seed_admin_account.ts",
    "predev": "node scripts/patch-next-drive-root-watch.cjs && prisma generate",
    "prebuild": "prisma generate",
    "pretest": "prisma generate",
    "postinstall": "node scripts/patch-next-drive-root-watch.cjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.2",
    "apify-client": "^2.25.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "mariadb": "^3.4.5",
    "next": "16.3.5",
    "nodemailer": "^7.0.13",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.14",
    "typescript": "^5"
  }
}
